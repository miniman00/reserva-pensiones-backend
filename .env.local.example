# Backend local
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/pensions
DB_USER=pensions
DB_PASSWORD=pensions

GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
# Cuenta SUPER_ADMIN de sistema administrada por infraestructura.
APP_BACKOFFICE_SUPER_ADMIN_USERNAME=soporte
# Hash BCrypt cost 12 generado fuera de la aplicación; no guardar la contraseña en texto plano
APP_BACKOFFICE_SUPER_ADMIN_PASSWORD_HASH=
APP_BACKOFFICE_SUPER_ADMIN_DISPLAY_NAME=Soporte
APP_BACKOFFICE_SUPER_ADMIN_EMAIL=soporte@tu-dominio.com
APP_BACKOFFICE_SUPER_ADMIN_REQUIRED=false
APP_BACKOFFICE_SESSION_TTL=PT8H
APP_BACKOFFICE_SESSION_IDLE_TIMEOUT=PT2H
APP_BACKOFFICE_REAUTH_TTL=PT10M
# MFA TOTP. En local se puede dejar deshabilitado hasta configurar una clave de 32 bytes Base64.
APP_BACKOFFICE_MFA_ENABLED=false
APP_BACKOFFICE_MFA_ISSUER=Pensiones Backoffice
# Generar, por ejemplo: openssl rand -base64 32
APP_BACKOFFICE_MFA_MASTER_KEY=
# Break-glass: mantener SIEMPRE deshabilitado. Activar temporalmente solo durante una recuperación MFA del SUPER_ADMIN.
APP_BACKOFFICE_MFA_BREAK_GLASS_ENABLED=false
# Hash BCrypt de un token aleatorio de al menos 32 caracteres. Nunca guardar el token en Git.
APP_BACKOFFICE_MFA_BREAK_GLASS_TOKEN_HASH=
# Expiración absoluta ISO-8601; al habilitarlo no puede estar a más de 24 horas. Ej.: 2026-08-31T23:30:00-03:00
APP_BACKOFFICE_MFA_BREAK_GLASS_EXPIRES_AT=
APP_BACKOFFICE_SESSION_COOKIE_NAME=PENSIONES_BACKOFFICE_SESSION
APP_BACKOFFICE_SESSION_COOKIE_PATH=/api
APP_BACKOFFICE_SESSION_COOKIE_SECURE=false
APP_BACKOFFICE_SESSION_COOKIE_SAME_SITE=Strict
APP_BACKOFFICE_LOGIN_IP_MAX_ATTEMPTS=30
APP_BACKOFFICE_LOGIN_IP_WINDOW=PT10M
APP_BACKOFFICE_LOGIN_USERNAME_MAX_ATTEMPTS=10
APP_BACKOFFICE_LOGIN_USERNAME_WINDOW=PT15M

# Master switches comerciales: el Backoffice solo los muestra; no puede cambiarlos.
APP_MONETIZATION_ENABLED=false
APP_PAYMENTS_ALLOWED=true
# Base64 de 32 bytes; generar una clave propia antes de guardar credenciales reales en BD.
APP_PAYMENT_SECRETS_MASTER_KEY=

# Almacenamiento multimedia local (default)
APP_MEDIA_STORAGE_PROVIDER=local
MEDIA_ROOT=./uploads

# Email transaccional de Pensiones: mismo esquema local/producción, cambia solo el proveedor.
# Local: SMTP (Gmail con contraseña de aplicación).
APP_MAIL_ENABLED=true
APP_MAIL_PROVIDER=smtp
APP_MAIL_FROM="Pensiones <tu-cuenta@gmail.com>"
APP_MAIL_SUPPORT_EMAIL=soporte@codevaru.com
# Opcional. Si queda vacío se usa APP_FRONTEND_URL + /brand/pensions-portal-mark.png
APP_MAIL_BRAND_LOGO_URL=

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-cuenta@gmail.com
SPRING_MAIL_PASSWORD=tu-password-de-aplicacion
MAIL_DEBUG=false

# Brevo no se usa en local mientras APP_MAIL_PROVIDER=smtp.
APP_BREVO_API_KEY=
APP_BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email

# Protección del buscador público
APP_PUBLIC_QUERY_TIMEOUT_MS=5000
APP_PUBLIC_RATE_DETAIL_MAX=90
