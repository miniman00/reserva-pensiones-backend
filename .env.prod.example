SPRING_PROFILES_ACTIVE=prod
PORT=8080

DB_URL=jdbc:postgresql://db-host:5432/pensions
DB_USER=pensions
DB_PASSWORD=change-me

# Flyway administra el esquema. No usar ddl-auto=update en producción.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
APP_FRONTEND_URL=https://pensiones.tu-dominio.com
# Origenes exactos autorizados para la web publica y el Backoffice.
APP_CORS_ALLOWED_ORIGINS=https://pensiones.tu-dominio.com,https://admin.pensiones.tu-dominio.com
# Cuenta SUPER_ADMIN de sistema administrada por infraestructura.
# No guardes la contraseña ni el hash real en Git; configúralo como secreto del entorno.
APP_BACKOFFICE_SUPER_ADMIN_USERNAME=soporte
# Hash BCrypt cost 12 generado fuera de la aplicación; no guardar la contraseña en texto plano
APP_BACKOFFICE_SUPER_ADMIN_PASSWORD_HASH=
APP_BACKOFFICE_SUPER_ADMIN_DISPLAY_NAME=Soporte
APP_BACKOFFICE_SUPER_ADMIN_EMAIL=soporte@tu-dominio.com
APP_BACKOFFICE_SUPER_ADMIN_REQUIRED=true
APP_BACKOFFICE_SESSION_TTL=PT8H
APP_BACKOFFICE_SESSION_IDLE_TIMEOUT=PT30M
APP_BACKOFFICE_REAUTH_TTL=PT10M
# MFA obligatorio para ADMIN y SUPER_ADMIN en producción. No reutilizar APP_PAYMENT_SECRETS_MASTER_KEY.
APP_BACKOFFICE_MFA_ENABLED=true
APP_BACKOFFICE_MFA_ISSUER=Pensiones Backoffice
# Base64 de 32 bytes administrada como secreto de infraestructura: openssl rand -base64 32
APP_BACKOFFICE_MFA_MASTER_KEY=
# Break-glass: mantener SIEMPRE deshabilitado. Activar temporalmente solo durante una recuperación MFA del SUPER_ADMIN.
APP_BACKOFFICE_MFA_BREAK_GLASS_ENABLED=false
# Hash BCrypt de un token aleatorio de al menos 32 caracteres. Nunca guardar el token en Git.
APP_BACKOFFICE_MFA_BREAK_GLASS_TOKEN_HASH=
# Expiración absoluta ISO-8601; al habilitarlo no puede estar a más de 24 horas. Ej.: 2026-08-31T23:30:00-03:00
APP_BACKOFFICE_MFA_BREAK_GLASS_EXPIRES_AT=
APP_BACKOFFICE_SESSION_COOKIE_NAME=PENSIONES_BACKOFFICE_SESSION
APP_BACKOFFICE_SESSION_COOKIE_PATH=/api
APP_BACKOFFICE_SESSION_COOKIE_SECURE=true
APP_BACKOFFICE_SESSION_COOKIE_SAME_SITE=Strict
APP_BACKOFFICE_LOGIN_IP_MAX_ATTEMPTS=30
APP_BACKOFFICE_LOGIN_IP_WINDOW=PT10M
APP_BACKOFFICE_LOGIN_USERNAME_MAX_ATTEMPTS=10
APP_BACKOFFICE_LOGIN_USERNAME_WINDOW=PT15M

# Monetización mantiene su master de infraestructura. Pagos usan un kill switch separado;
# la habilitación operativa y proveedores se administran desde Backoffice/BD.
APP_MONETIZATION_ENABLED=false
APP_PAYMENTS_ALLOWED=false
# Base64 de 32 bytes gestionada como secreto de infraestructura.
APP_PAYMENT_SECRETS_MASTER_KEY=

MEDIA_ROOT=/var/lib/pensions/uploads
APP_MEDIA_STORAGE_PROVIDER=local

# Email transaccional de Pensiones: mismo esquema local/producción, cambia solo el proveedor.
# Producción: Brevo por API HTTP. No requiere SPRING_MAIL_*.
APP_MAIL_ENABLED=true
APP_MAIL_PROVIDER=brevo
APP_MAIL_FROM="Pensiones <no-reply@codevaru.com>"
APP_MAIL_SUPPORT_EMAIL=soporte@codevaru.com
# Opcional. Si queda vacío se usa APP_FRONTEND_URL + /brand/pensions-portal-mark.png
APP_MAIL_BRAND_LOGO_URL=
APP_BREVO_API_KEY=<brevo-api-key>
APP_BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email

LEGAL_OPERATOR_NAME=CodeVaru
LEGAL_CONTACT_EMAIL=soporte@codevaru.com

SESSION_COOKIE_SECURE=true
# Use "none" only when frontend and API are truly cross-site; requires HTTPS.
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=12h

# Protección del buscador público
APP_PUBLIC_QUERY_TIMEOUT_MS=5000
APP_PUBLIC_RATE_DETAIL_MAX=90

# Operación de media. Mantener cleanup=false inicialmente; observar la reconciliación antes de habilitar borrado.
APP_MEDIA_MAINTENANCE_MIN_USABLE_BYTES=134217728
APP_MEDIA_MAINTENANCE_CLEANUP_ENABLED=false
APP_MEDIA_MAINTENANCE_ORPHAN_GRACE=PT24H

# Outbox durable de email (ver docs/PRODUCTION_OPERATIONS.md)
APP_MAIL_OUTBOX_BATCH_SIZE=20
APP_MAIL_OUTBOX_MAX_ATTEMPTS=8
APP_MAIL_OUTBOX_LEASE=PT15M
APP_MAIL_OUTBOX_POLL_DELAY_MS=15000

# Jobs programados: evita que envío de correo bloquee conciliación de pagos/mantenimiento.
SCHEDULER_POOL_SIZE=4
SCHEDULER_SHUTDOWN_TIMEOUT=20s
